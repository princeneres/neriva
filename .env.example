# Database (environment-level config, never portal-editable).
# Leave DATABASE_URL unset and `pnpm dev` starts an embedded PostgreSQL with
# its data in .neriva/pgdata. Set it to use your own server instead, for
# example the one in docker-compose.yml:
# DATABASE_URL=postgres://neriva:neriva@localhost:5432/neriva

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Media (documents and media library file storage root)
MEDIA_STORAGE_DIR=./uploads

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

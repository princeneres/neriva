# Database (environment-level config, never portal-editable).
# Leave DATABASE_URL unset and `pnpm dev` starts an embedded PostgreSQL with
# its data in .neriva/pgdata. Set it to use your own server instead, for
# example the one in docker-compose.yml:
# DATABASE_URL=postgres://neriva:neriva@localhost:5432/neriva

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Reverse proxy. Unset means no proxy is trusted: the connecting address is the
# client and X-Forwarded-For is ignored, which is correct when the API is
# reachable directly. Behind the Caddy proxy of docker-compose.prod.yml, set the
# Docker network subnet so only the proxy can name the client IP used by the
# per-IP rate limits and by the request log. Run
# `docker network inspect <project>_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'`
# to read the subnet, or declare a fixed one in the compose file.
# Accepts a comma separated list of IP addresses and CIDR ranges, plus the
# keywords loopback, linklocal and uniquelocal. Hop counts are rejected.
# TRUST_PROXY=172.18.0.0/16
# TRUST_PROXY=true trusts X-Forwarded-For from anyone, so any caller can forge a
# fresh client IP per request and walk around the login rate limit. Only use it
# when the API can be reached exclusively through the proxy.

# Logging: fatal, error, warn, info, debug, trace or silent. Defaults to info in
# production (one JSON line per request) and warn elsewhere, so `pnpm dev` stays
# readable. Credentials, authorization headers, cookies and request bodies are
# never logged.
# LOG_LEVEL=info

# Production Docker Compose hostnames. Point DNS A/AAAA records at the VM.
# WEB_HOST=cms.example.com
# API_HOST=api.example.com

# Media (documents and media library file storage root)
MEDIA_STORAGE_DIR=./uploads

# Auth
JWT_ACCESS_SECRET=change-me
# Required for the first production boot. Use a random password with at least 15 characters.
NERIVA_INITIAL_ADMIN_PASSWORD=change-me-before-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

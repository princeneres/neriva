# Database (environment-level config, never portal-editable).
# Leave DATABASE_URL unset and `pnpm dev` starts an embedded PostgreSQL with
# its data in .neriva/pgdata. Set it to use your own server instead, for
# example the one in docker-compose.yml:
# DATABASE_URL=postgres://neriva:neriva@localhost:5432/neriva

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Production Docker Compose hostnames. Point DNS A/AAAA records at the VM.
# WEB_HOST=cms.example.com
# API_HOST=api.example.com

# Media (documents and media library file storage root)
MEDIA_STORAGE_DIR=./uploads

# Auth
JWT_ACCESS_SECRET=change-me
# Required for the first production boot. Use a random password with at least 15 characters.
NERIVA_INITIAL_ADMIN_PASSWORD=change-me-before-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
